{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "casinodex",
  "main": ".open-next/worker.js",
  // Set this to today's date
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
