# Optional. Enables saving sponsor assignments from /admin.
# Leave empty to keep /admin read-only (edit content/sponsors.json instead).
ADMIN_PASSWORD=changeme

# Optional env overrides — these win over content/sponsors.json.
# A slot fills only when ENABLED=true AND SLUG matches a listing.
# Gold seats stay empty unless you set both. CasinoDex never auto-fills paid slots.

# SPONSOR_GOLD_1_ENABLED=false
# SPONSOR_GOLD_1_SLUG=
# SPONSOR_GOLD_2_ENABLED=false
# SPONSOR_GOLD_2_SLUG=
# SPONSOR_GOLD_3_ENABLED=false
# SPONSOR_GOLD_3_SLUG=

# SPONSOR_SILVER_CASINO_ENABLED=false
# SPONSOR_SILVER_CASINO_SLUG=
# SPONSOR_SILVER_SPORTS_ENABLED=false
# SPONSOR_SILVER_SPORTS_SLUG=
# SPONSOR_SILVER_CRYPTO_ENABLED=false
# SPONSOR_SILVER_CRYPTO_SLUG=

# SPONSOR_BRONZE_1_ENABLED=false
# SPONSOR_BRONZE_1_SLUG=
